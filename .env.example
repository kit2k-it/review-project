# Database
DATABASE_URL="postgres://..."

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI
OPENAI_API_KEY="sk-..."

# Google Places
GOOGLE_PLACES_API_KEY="..."

# ============================================
# SMTP EMAIL CONFIGURATION (for sending complaint emails)
# ============================================

# For Gmail (with 2FA enabled - RECOMMENDED):
# 1. Enable 2-Factor Authentication in your Google Account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Use that 16-character password below
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-character-app-password"
SMTP_FROM="QRReview <noreply@yourdomain.com>"
SMTP_FROM_NAME="QRReview"
SMTP_SECURE="false"

# For other email providers:
# - Outlook/Hotmail: smtp-mail.outlook.com, port 587
# - Yahoo: smtp.mail.yahoo.com, port 587 or 465
# - Custom domain: your-smtp-server.com, port 587 (TLS) or 465 (SSL)

# ============================================
# OTHER CONFIG
# ============================================
REVIEW_THRESHOLD="10"
REVIEW_BATCH_SIZE="15"
